          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst users = pm.response.json();\r\n\r\nconst selectedUser = users[0];\r\n\r\npm.collectionVariables.set(\"userId\", selectedUser.id);\r\npm.collectionVariables.set(\"userPhone\", selectedUser.phone);\r\n\r\npm.collectionVariables.set(\"userId\", selectedUser.id);\r\n\r\nconsole.log(\"Stored User ID:\", selectedUser.id);\r\n\r\npm.test(\"User ID was stored\", function () {\r\n    pm.expect(selectedUser.id).to.exist;\r\n});"
            ]
          }
        }
      ],
