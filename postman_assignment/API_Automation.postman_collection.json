          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.test(\"Returned ID matches stored ID\", function () {\r\n    pm.expect(response.id).to.eql(\r\n        Number(pm.collectionVariables.get(\"userId\"))\r\n    );\r\n});\r\n\r\npm.test(\"Phone field is not empty\", function () {\r\n    const phone = pm.collectionVariables.get(\"userPhone\");\r\n\r\n    pm.expect(phone).to.exist;\r\n    pm.expect(phone).to.not.be.empty;\r\n});"
            ]
          }
        }
